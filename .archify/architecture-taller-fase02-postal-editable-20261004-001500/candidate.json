  "cards": [
    {
      "dot": "emerald",
      "title": "Cliente unico multi-taller",
      "items": [
        "CURP, RFC y email evitan duplicados",
        "Si el cliente existe, solo se registra la visita al taller actual",
        "La tabla customer_workshop conserva primera visita, ultima visita y usuario que registro"
      ]
    },
    {
      "dot": "violet",
      "title": "Patron facade",
      "items": [
        "Vue no llama directamente a fetch; usa workshopFacade.js",
        "Los controladores delegan a facades backend antes de service y repository",
        "El mismo flujo aplica para clientes, talleres y catalogo postal"
      ]
    },
    {
      "dot": "amber",
      "title": "Operacion offline",
      "items": [
        "SEPOMEX vive en MySQL local",
        "El CP autocompleta estado, municipio y colonias",
        "Los selects encadenados tambien permiten obtener CP desde estado, municipio y colonia"
      ]
    },
    {
      "dot": "orange",
      "title": "Archivos y seguridad",
      "items": [
        "Fotos multipart se guardan en disco o volumen, no en base64",
        "Imagenes limitadas a 15 MB",
        "Suspension global de cliente esta restringida a GERENTE"
      ]
    }
  ]
