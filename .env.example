# Copia este archivo a .env y sustituye todos los valores antes de iniciar Docker.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=taller_db
MYSQL_USER=taller_app
MYSQL_PASSWORD=replace-with-a-strong-application-password

# Variables que consume Spring Boot fuera de Docker Compose.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taller_db
DB_USERNAME=taller_app
DB_PASSWORD=replace-with-the-application-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
